{
  "rules": {
    "automocion": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "faltas": {
          "$id": {
            ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['modulo', 'fecha'])",
            "modulo": {
              ".validate": "newData.isString() && newData.val().matches(/^(MOT|ELE|TRA|DIG|ING|IPE)$/)"
            },
            "fecha": {
              ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "retrasos": {
          "$modulo": {
            ".validate": "$modulo.matches(/^(MOT|ELE|TRA|DIG|ING|IPE)$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
